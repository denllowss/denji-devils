{
  "version": 2,
  "rewrites": [
    {
      "source": "/iqc3",
      "destination": "/api/iqc3"
    },
    {
      "source": "/iqc3/",
      "destination": "/api/iqc3"
    },
    {
      "source": "/api/iqc3/",
      "destination": "/api/iqc3"
    },
    {
      "source": "/app3",
      "destination": "/app3.html"
    },
    {
      "source": "/iqc",
      "destination": "/api/iqc"
    },
    {
      "source": "/iqc/",
      "destination": "/api/iqc"
    },
    {
      "source": "/iqc2",
      "destination": "/api/iqc2"
    },
    {
      "source": "/iqc2/",
      "destination": "/api/iqc2"
    },
    {
      "source": "/api/iqc/",
      "destination": "/api/iqc"
    },
    {
      "source": "/api/iqc2/",
      "destination": "/api/iqc2"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/api/dl",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/dl/",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/stream",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/stream/",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/proxy",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/proxy/",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/health/",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/profile",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/profile/",
      "destination": "/api/index.js"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/dl",
      "destination": "/dl.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "excludeFiles": "{api/iqc*.js,api/_template*.html,api/iqc3-assets/**,src/services/iqc-runtime.js,node_modules/@sparticuz/chromium/**,node_modules/puppeteer-core/**,node_modules/@puppeteer/browsers/**}"
    },
    "api/iqc.js": {
      "includeFiles": "{api/_template*.html,node_modules/@sparticuz/chromium/bin/*.br}",
      "memory": 2048,
      "maxDuration": 60
    },
    "api/iqc2.js": {
      "includeFiles": "{api/_template*.html,node_modules/@sparticuz/chromium/bin/*.br}",
      "memory": 2048,
      "maxDuration": 60
    },
    "api/iqc3.js": {
      "includeFiles": "{api/_template*.html,api/iqc3-assets/**,node_modules/@sparticuz/chromium/bin/*.br}",
      "memory": 2048,
      "maxDuration": 60
    }
  }
}
